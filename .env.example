APP_NAME="Thi chứng chỉ HVNH"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_URL=http://localhost
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---
# Mac dinh dung SQLite, khong can cai MySQL. Neu muon dung MySQL, doi DB_CONNECTION=mysql va dien thong tin ben duoi.
DB_CONNECTION=sqlite
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=hvnh
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# Ten mien email truong dung de kiem tra khi Sinh vien dang ky (App\Http\Controllers\Auth\RegisterController)
STUDENT_EMAIL_DOMAIN=@hvnh.edu.vn

# --- Mail ---
# Mac dinh MAIL_MAILER=log: email se duoc ghi vao storage/logs/laravel.log de test, chua gui that.
# De gui email that, doi sang smtp va dien thong tin SMTP that cua truong/Gmail.
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@hvnh.edu.vn"
MAIL_FROM_NAME="${APP_NAME}"

# --- Thanh toán VNPAY / NAPAS ---
# Dang ky tai khoan merchant sandbox mien phi tai https://sandbox.vnpayment.vn de lay 2 gia tri ben duoi.
# Neu de trong, he thong tu chuyen sang cong thanh toan MO PHONG (khong can tai khoan that) de demo/test.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL="${APP_URL}/thanh-toan/vnpay/return"
